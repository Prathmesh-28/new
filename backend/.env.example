DATABASE_URL=postgresql://user:pass@localhost:5432/headroom
JWT_SECRET=change-me-in-production
JWT_REFRESH=change-me-refresh-in-production
# Super admin bootstrap — set to YOUR email + a strong password (min 10 chars).
# Only used to CREATE a brand-new super_admin; never auto-promotes an existing
# account. To promote an existing account run: node src/scripts/make-admin.js <email>
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Headroom <you@gmail.com>
ANTHROPIC_API_KEY=sk-ant-...
FRONTEND_URL=http://localhost:5173
PORT=4000
