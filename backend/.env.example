# ── Headroom API (Node/Express) — copy to backend/.env ──────────────────────────
# Only DATABASE_URL + JWT secrets are required; everything else degrades
# gracefully (the matching feature shows a "Preview" badge until its key is set).

# ── Required ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/headroom
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH=change-me-to-a-different-long-random-string
FRONTEND_URL=http://localhost:5173
PORT=4000
# BACKEND_URL is used in Razorpay callback URLs (your deployed API origin)
BACKEND_URL=http://localhost:4000

# ── Super-admin bootstrap ────────────────────────────────────────────────────────
# Creates a brand-new super_admin only; never auto-promotes an existing account.
# To promote an existing account: node src/scripts/make-admin.js <email>
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Payments (Razorpay) — subscriptions + invoice collections ────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI (Claude) — categorisation + receipt scanning ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Messaging ─────────────────────────────────────────────────────────────────────
# WhatsApp digests + chase (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Mobile push (Firebase Cloud Messaging, HTTP v1). Paste the service-account
# JSON (Firebase → Project settings → Service accounts → Generate new private
# key) as one line, or base64-encode it. The legacy FCM "server key" is dead.
FCM_SERVICE_ACCOUNT=
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Headroom <you@gmail.com>

# ── Webhooks / cron ───────────────────────────────────────────────────────────────
# Shared secret guarding the internal cron self-calls (daily digest etc.)
INTERNAL_CRON_SECRET=change-me
# Shared secret for the Tally push webhook (required, else the endpoint is disabled)
TALLY_WEBHOOK_SECRET=change-me

# ── Partner rails (optional — leave blank to keep the feature in Preview) ─────────
FINBOX_API_KEY=          # bank/account-aggregator sync + credit disbursement
SETU_CLIENT_ID=          # BNPL + earned-wage-advance payouts
MASTERS_INDIA_API_KEY=   # real GST e-invoice / IRN via GSP
KYC_API_KEY=             # PAN/GSTIN verification

# ── Observability (optional) ──────────────────────────────────────────────────────
# SENTRY_DSN=            # wire into lib/logger.error() to forward errors
