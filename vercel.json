{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://headroom-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://headroom-backend.onrender.com/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://headroom-backend.onrender.com/webhook/:path*"
    },
    {
      "source": "/.well-known/:file*",
      "destination": "/.well-known/:file*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
