# ══════════════════════════════════════════════════════════════════════════════
# Headroom — frontend (Vite + React) environment
# Copy to .env (or .env.local). Backend vars live in backend/.env.example.
# ══════════════════════════════════════════════════════════════════════════════

# API origin the SPA calls.
#  - Web (Vercel): leave blank → same-origin, proxied via vercel.json rewrites.
#  - Local dev against a local backend: http://localhost:4000
#  - Native build against a LAN backend: http://<your-lan-ip>:4000
VITE_API_URL=

# Optional: release tag attached to client error reports (telemetry).
VITE_RELEASE=
