<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="dashboard"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_dashboard">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="headroom://app/dashboard"
            android:targetPackage="in.headroom.app"
            android:targetClass="in.headroom.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="forecast"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_forecast">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="headroom://app/forecast"
            android:targetPackage="in.headroom.app"
            android:targetClass="in.headroom.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="alerts"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_alerts">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="headroom://app/alerts"
            android:targetPackage="in.headroom.app"
            android:targetClass="in.headroom.app.MainActivity" />
    </shortcut>
</shortcuts>
