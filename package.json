{
  "name": "headroom",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "npm run build && cap sync ios && cap open ios",
    "mobile:android": "npm run build && cap sync android && cap open android",
    "mobile:dev:ios": "cap run ios --livereload --external",
    "mobile:dev:android": "cap run android --livereload --external"
  },
